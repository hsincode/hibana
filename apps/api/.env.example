# Discord bot token (guild list + membership). Same token as the bot process.
DISCORD_TOKEN=

# Discord OAuth app (not the bot token). Redirect:
#   {WEB_PUBLIC_BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# This API's public origin. Used for OAuth redirect.
WEB_PUBLIC_BASE_URL=http://localhost:3000

# SPA origin. CORS + post-login redirect.
FRONTEND_ORIGIN=http://localhost:5173

WEB_SESSION_SECRET=
# Comma-separated Discord user IDs. These are Administrator on every login;
# everyone else starts as Free until an admin/mod assigns a role.
WEB_ADMIN_IDS=
WEB_INTERNAL_TOKEN=

# Conversation audit log (`POST /internal/logs` + `/api/logs`). Default off:
# each answered turn is a Neon INSERT. Set true only when the dashboard log
# page is needed.
# WEB_LOGS_ENABLED=true

# Key for Anthropic's Admin API, for the dashboard's /analytics page, which
# reads the organization's cost report. Optional: without it the page says it
# is not set up. Use an Admin API key (sk-ant-admin01-...), or a personal key
# that is not scoped to a workspace and whose account may read the report;
# Anthropic answers 403 when the account behind the key may not. A workspace
# API key (the bot's ANTHROPIC_API_KEY) is rejected. The key reaches beyond one
# workspace, so keep it only here. Admin API is not available to individual
# accounts: an "Individual Org" has no Admin keys page until it is converted
# to a team organization in Console > Settings > Organization.
# ANTHROPIC_ADMIN_API_KEY=

# Neon (or any Postgres). Vercel Postgres is Neon under the hood.
# https://console.neon.tech — free tier is enough.
DATABASE_URL=

# Local listen (ignored on Vercel)
WEB_BIND=127.0.0.1:3000
