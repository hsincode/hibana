DISCORD_TOKEN=
# Optional: register slash commands in one test guild instead of globally.
DISCORD_COMMAND_GUILD_ID=
PROVIDER=CODEX_PLUS
LLM_MODEL=gpt-5.6-luna
# Stored reasoning depth. Ultra is Claude Code's Ultracode: the root runs at
# xhigh while it is on, and this value applies again when it is off. Legacy
# LLM_EFFORT=ultra still means max + Ultra on unless ULTRA_MODE overrides it.
LLM_EFFORT=max
# Leave blank to preserve the legacy LLM_EFFORT=ultra behavior; true/false override it.
ULTRA_MODE=
# true seeds new settings rows with Multi-Agent (a fixed role team with Codex's
# proactive delegation; it also stores ultra_mode=true but is not Ultracode).
MULTI_AGENT=
# Independent provider credentials; no cross-account fallback.
DEEPSEEK_API_KEY=
CLAUDE_KIRO_API_KEY=
CLAUDE_MAX_API_KEY=
# Anthropic's own API, billed per token. The "Anthropic / Auto (Jev)" preset
# also needs JEV_API_KEY and JEV_ENABLED; without them it runs Haiku 5.5 / high.
ANTHROPIC_API_KEY=
# Anthropic Workspace (docs/anthropic-workspace.md, #76): turns run as Claude Managed
# Agents sessions, one cloud container per channel. It has its own key and
# never falls back to ANTHROPIC_API_KEY. Billed per token, plus $0.08 per hour
# a session is running, plus web searches. A dedicated Console workspace with
# a spend limit is recommended. Against the real API it has only been run
# from a workstation, on Haiku 5.5 (docs/anthropic-workspace.md).
# ANTHROPIC_CUSTOM_HEADERS, if set, is read by the SDK and its headers are
# added to these requests; an x-api-key or Authorization in it is not used.
ANTHROPIC_WORKSPACE_API_KEY=
CODEX_GEMINI_API_KEY=
GROK_FREE_API_KEY=
GROK_HEAVY_API_KEY=
CODEX_PLUS_API_KEY=
CODEX_PRO_API_KEY=
OPENROUTER_API_KEY=
# Jev Decisions subagent has its own OpenRouter key (no fallback to chat keys).
JEV_API_KEY=
# Default for ordinary evaluations; server/personal jev_enabled overrides it.
JEV_ENABLED=true
# Separate opt-in: Jev selects workspace/search/browser actions; candidates can use all available parent tools.
# Server/personal jev_task_enabled overrides this; JEV_API_KEY is shared.
JEV_TASK_ENABLED=false
# Jev's experimental image input (#83). false sends Jev text only, as before.
JEV_IMAGES_ENABLED=true
OPENAI_API_KEY=
XAI_API_KEY=
# Each provider optionally accepts <PROVIDER>_BASE_URL.
# Custom: PROVIDER=custom, LLM_BASE_URL, LLM_API_KEY, LLM_MODEL.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
HIBANA_DATA_DIR=./data
# Conversation history and auto routes survive a restart in this SQLite file
# (default: HIBANA_DATA_DIR/conversations.db). Set it empty to keep them in
# process memory only.
# CONVERSATION_DB_PATH=
# Leave empty to use local JSON settings.
WEB_API_URL=
WEB_INTERNAL_TOKEN=
WEB_ADMIN_IDS=
TOOLS_ENABLED=true
SANDBOX_ENABLED=true
SANDBOX_IMAGE=hibana-sandbox:latest
# Optional on-demand home tools; setting the endpoint never connects by itself.
BROWSER_PROXY_URL=
BROWSER_PROXY_USERNAME=
HOME_RELAY_CONTROL_SOCKET=/run/hibana-home-egress/control.sock
SKILLS_ENABLED=true
SKILLS_DIR=./skills
WEB_SEARCH_ENABLED=true
EXA_API_KEY=
EXTRA_TRIGGERS=
STATIC_SITE_ENABLED=false
STATIC_SITE_BIND=127.0.0.1:8080
STATIC_SITE_BASE_URL=
VOICE_ENABLED=false
VOICE_S2S_MODEL=grok-voice-latest
VOICE_S2S_VOICE=eve
VPN_ENABLED=false
# surfshark (default) or vpngate. vpngate needs no credentials.
VPN_PROVIDER=surfshark
# Surfshark: jp-tok. VPN Gate: jp / us / auto. jp-tok is treated as Japan on VPN Gate.
VPN_SERVER=jp-tok
SURFSHARK_OPENVPN_USERNAME=
SURFSHARK_OPENVPN_PASSWORD=
LOG_LEVEL=info
# Anthropic Workspace limits. The defaults are the AI's proposal in #76, not
# yet decided by the owner. Amounts are US dollars at Anthropic's list prices.
# A value outside its range stops the start.
# What one turn may add to its session; the second applies to Haiku Ultra.
# 0.05 to 100 each: a turn is not started with less than 5 cents.
# ANTHROPIC_WORKSPACE_TURN_BUDGET_USD=1
# ANTHROPIC_WORKSPACE_ULTRA_TURN_BUDGET_USD=3
# What all Workspace turns together may add in one UTC day (0.01 to 10000)
# and month (0.01 to 100000). A turn is refused once less than 5 cents is
# left. On top of the reported cost, these two count a cent for every new
# session, and a turn's whole allowance, once, when its session reports usage
# (tokens, running time) but no cost. A turn whose session reports no usage
# at all, such as one cleared before its message was taken up, adds nothing;
# if the session reports some by the next sweep (every minute) or by the time
# it is removed, the allowance is counted then.
# ANTHROPIC_WORKSPACE_DAILY_BUDGET_USD=5
# ANTHROPIC_WORKSPACE_MONTHLY_BUDGET_USD=50
# Wall-clock time of one turn: 20 minutes, and 60 for Haiku Ultra.
# ANTHROPIC_WORKSPACE_TURN_TIMEOUT_MS=1200000
# ANTHROPIC_WORKSPACE_ULTRA_TURN_TIMEOUT_MS=3600000
# Workspace turns running at once in the whole bot, and the longest message
# one of them accepts. Messages that an earlier attempt could not send go
# with the next one; when together they are longer than this, the newest
# that fit are sent and the reply says how many were left out.
# ANTHROPIC_WORKSPACE_MAX_CONCURRENT=2
# ANTHROPIC_WORKSPACE_INPUT_MAX_CHARS=60000
# Network of the container: unrestricted, or limited to the host names listed
# (comma-separated, no scheme or port) plus package registries. A host list
# without "limited" stops the start. With "limited", list Discord's CDN hosts
# or attachments cannot be fetched; web search and fetch follow the same list.
# ANTHROPIC_WORKSPACE_NETWORKING=unrestricted
# ANTHROPIC_WORKSPACE_ALLOWED_HOSTS=
# The container's own web search and fetch. WEB_SEARCH_ENABLED=false and a
# server's exa "off" switch them off too.
# ANTHROPIC_WORKSPACE_WEB_ENABLED=true
# The network and web settings apply to sessions created afterwards; an
# existing session keeps what it was created with.
# Multi-Agent V2 collaboration tools. Dynamic workflows also need this.
SUBAGENT_ENABLED=true
# Active descendants across one task tree, excluding the root agent.
SUBAGENT_MAX_CONCURRENT=6
# HsinCLI history policy: default 1 recent turn; "none" is always allowed.
SUBAGENT_FORK_ALLOW_ALL=false
# Optional numeric turn cap; setting a cap also disallows "all".
# SUBAGENT_FORK_MAX_TURNS=3
# Claude Code dynamic workflows: the Workflow tool, the "ultracode" keyword
# and Ultra (Ultracode). false turns all three off, and Anthropic Workspace's
# Haiku Ultra with them.
WORKFLOWS_ENABLED=true
# false ignores the "ultracode" keyword in typed messages.
ULTRACODE_KEYWORD_TRIGGER=true
# Concurrent agent() calls per workflow run (1-256). Blank uses Claude Code's
# min(16, max(2, CPUs - 2)), counting a container CPU quota.
WORKFLOW_MAX_CONCURRENT_AGENTS=
# Size advice in the Workflow description: unrestricted, small (<5 agents),
# medium (<10, the default when blank) or large (<50). Not a hard limit.
WORKFLOW_SIZE_GUIDELINE=

# Optional local image PC, reached only through its authenticated SSH tunnel.
IMAGE_WORKER_URL=
IMAGE_WORKER_TOKEN=

# Provider recovery: retry counts exclude the initial request. No incoming bytes
# for five minutes triggers a reconnect; active reasoning streams may run longer.
LLM_REQUEST_MAX_RETRIES=4
LLM_STREAM_MAX_RETRIES=5
LLM_STREAM_IDLE_TIMEOUT_MS=300000
