exports[`every deprecated provider receives the same request as before 1`] = `
{
  "parts": {
    "#04084ff8fe0b": [
      {
        "description": "Find a record",
        "input_schema": {
          "properties": {
            "key": {
              "type": "string",
            },
          },
          "required": [
            "key",
          ],
          "type": "object",
        },
        "name": "lookup",
      },
    ],
    "#0fa281db3c0b": [
      {
        "content": "<multi_agent_mode>Policy.</multi_agent_mode>",
        "role": "developer",
      },
      {
        "content": 
"# AGENTS.md instructions
<INSTRUCTIONS>
Rules.
</INSTRUCTIONS>"
,
        "role": "user",
      },
      {
        "content": [
          {
            "text": "質問です",
            "type": "input_text",
          },
          {
            "image_url": "https://example.com/a.png",
            "type": "input_image",
          },
        ],
        "role": "user",
      },
      {
        "content": "調べます",
        "role": "assistant",
      },
      {
        "arguments": "{"key":"x"}",
        "call_id": "call_1",
        "name": "lookup",
        "type": "function_call",
      },
      {
        "call_id": "call_1",
        "output": "{"ok":true}",
        "type": "function_call_output",
      },
      {
        "content": "Late note.",
        "role": "developer",
      },
      {
        "content": "Continue.",
        "role": "user",
      },
    ],
    "#287c5f205f8e": "System text.",
    "#500a053bcdec": [
      {
        "description": "Find a record",
        "name": "lookup",
        "parameters": {
          "properties": {
            "key": {
              "type": "string",
            },
          },
          "required": [
            "key",
          ],
          "type": "object",
        },
        "strict": false,
        "type": "function",
