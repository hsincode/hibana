{
  "name": "hibana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "bun run --cwd apps/bot dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "bun check .",
    "test": "bun test --parallel apps/bot/src apps/api/src apps/relay/src packages/shared/src ./scripts",
    "test:ui": "bun run --cwd apps/web test:ui",
    "build": "bun run --filter \"*\" build",
    "ci": "bun run typecheck && bun run test && bun run build",
    "postinstall": "bun run --cwd packages/shared build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/bun": "^1.4.0"
  }
}
