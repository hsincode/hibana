{
  "name": "@hibana/shared",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/catalog.js"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "default": "./dist/settings.js"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./dist/audit.js"
    },
    "./billing": {
      "types": "./src/billing.ts",
      "default": "./dist/billing.js"
    },
    "./budget": {
      "types": "./src/budget.ts",
      "default": "./dist/budget.js"
    },
    "./schedules": {
      "types": "./src/schedules.ts",
      "default": "./dist/schedules.js"
    }
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "bun build src/audit.ts src/billing.ts src/budget.ts src/catalog.ts src/schedules.ts src/settings.ts --target=bun --outdir=dist --packages=external"
  }
}
